[Unit]
Description=Dispara a checagem semanal do catalogo opencode zen

[Timer]
# Toda segunda as 08:00 -03 -- antes do expediente, com tempo de reagir caso
# um modelo tenha sumido do catalogo durante a semana.
OnCalendar=Mon *-*-* 08:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
