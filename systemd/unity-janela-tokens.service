[Unit]
Description=Notificacao de tokens por janela de 5h do Claude no Telegram
# Sem rede, o send_telegram falha em silencio e a janela fica sem aviso.
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/reaper/.local/bin/unity-janela-tokens
# O ai-usagebar e o unity-lib vivem em ~/.local/bin, que nao esta no PATH de um
# servico do systemd (ele nao le o perfil do shell). Sem isto, o script sobe
# sem a cota do Claude e ninguem percebe.
Environment=PATH=/home/reaper/.local/bin:/usr/local/bin:/usr/bin:/bin
