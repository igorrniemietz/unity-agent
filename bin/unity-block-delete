#!/usr/bin/env python3
"""Hook PreToolUse: BARRA exclusão e leitura de segredo, e avisa no Telegram.

Substitui o `unity-ask-on-delete`, que devolvia "ask". A troca foi decidida em
2026-07-31 pelo dono: ele não quer aprovar nada. E "perguntar antes" só protege
quem está olhando o celular — num orquestrador autônomo, um prompt ignorado às
3h não é proteção, é o agente paralisado até alguém acordar.

Contrato: "deny" quando detecta, silêncio (exit 0, stdout vazio) quando não.
O agente recebe no motivo a alternativa que funciona (`unity-trash`), então ele
segue trabalhando em vez de empacar — é o que separa barrar de travar.

Duas famílias barradas, por razões diferentes:

1. EXCLUSÃO — existe alternativa (`unity-trash`), então o trabalho continua.
2. SEGREDO (~/.ssh, arquivos .env) — não existe alternativa nem motivo: o
   orquestrador não tem o que fazer com a chave da DeepSeek nem com o token do
   bot. O `cwd` do supervisor é /home/reaper, então esses caminhos estão ao
   alcance dele por acidente, não por projeto.

Falha ABERTO de propósito, como o antecessor: se este script quebrar, o agente
volta ao comportamento do defaultMode em vez de ficar inútil. Um falso negativo
custa um item na lixeira; travar custa o agente inteiro.
"""
import json
import os
import re
import shlex
import subprocess
import sys

# Cada padrão é ancorado em início de comando ou depois de um separador
# (; && || | & ( ou início da linha), para não casar dentro de outra palavra
# nem dentro do nome de um arquivo — "confirm.sh" não vira confirmação.
SEP = r"(?:^|[\n;&|(]|&&|\|\||\bsudo\s+|\bxargs\s+|\bnohup\s+|\btime\s+)\s*"
APAGA = [
    (rf"{SEP}rm\b",                     "rm"),
    (rf"{SEP}rmdir\b",                  "rmdir"),
    (rf"{SEP}shred\b",                  "shred"),
    (rf"{SEP}unlink\b",                 "unlink"),
    (r"\bfind\b[^\n;&|]*\s-delete\b",   "find -delete"),
    (r"\bfind\b[^\n;&|]*-exec\s+rm\b",  "find -exec rm"),
    (rf"{SEP}git\s+clean\b",            "git clean"),
    (rf"{SEP}git\s+rm\b",               "git rm"),
    (r"\bdocker\s+(?:volume|image|container|system)\s+(?:rm|prune)\b", "docker rm/prune"),
    (rf"{SEP}truncate\b[^\n;&|]*-s\s*0\b", "truncate -s 0"),
]

# `unity-trash` é a saída autorizada. Sem esta isenção o hook barraria a própria
# alternativa que ele recomenda — o agente ficaria sem caminho nenhum.
ISENTO = re.compile(r"\bunity-trash\b")

# O que é segredo DE VERDADE. Até 2026-08-01 havia aqui um `/home/reaper/infra/`
# cru, que barrava a pasta inteira — inclusive os logs do llm-router, que são
# justamente a fonte de custo medido dos relatórios. O dono estreitou para .env
# e material de chave, alinhando o hook ao que o settings.json dele já dizia
# (`Read(/home/reaper/infra/**/.env)`), em vez da pasta toda.
SEGREDO = [
    (r"(?:^|[\s'\"=])~?/?(?:home/reaper/)?\.ssh/", "~/.ssh"),
    (r"\.env\b",                                   "arquivo .env"),
    (r"\.(?:key|pem|p12|pfx|keystore|jks)\b",      "arquivo de chave"),
    (r"\b(?:credentials|secrets?)\.(?:json|ya?ml|txt|ini)\b", "arquivo de credencial"),
    (r"\bid_(?:rsa|ed25519|ecdsa|dsa)\b",          "chave privada ssh"),
]

# Comandos que de fato LEEM/COPIAM um caminho recebido como argumento.
LEITURA = re.compile(
    r"^(?:cat|less|more|head|tail|bat|cp|mv|scp|rsync|tar|zip|base64|xxd|od|"
    r"strings|grep|rg|awk|sed|curl|wget|source|\.|export|printenv|dd|install)$")

# Comandos que recebem CÓDIGO numa string: ali o caminho vai embutido no
# argumento e não como token próprio, então o token-com-espaço é legítimo.
CODIGO = re.compile(r"^(?:python3?|node|bash|sh|zsh|perl|ruby|eval|deno|bun)$")

# Palavras que só prefixam outro comando; o comando real vem depois delas.
PREFIXO = re.compile(r"^(?:sudo|env|xargs|nohup|time|command|builtin|exec|then|do|else)$")


def _segmentos(cmd):
    """Quebra em comandos independentes, para avaliar cada um no seu contexto."""
    return [s for s in re.split(r"[\n;&|]+", cmd) if s.strip()]


def usa_segredo(cmd):
    """(nome_do_segredo) se o comando REALMENTE alcança um segredo, senão None.

    O discriminador é o token, não a string inteira. Um caminho de verdade vem
    como argumento próprio — sem espaço. Um caminho CITADO dentro de um prompt
    vem dentro de um token grande, cheio de espaços, que é dado para outro
    programa (`unity-delegar "...«/home/reaper/infra/x/.env»..."`), não lido
    por este comando.

    Foi essa a confusão que travou a Unity em 2026-08-01: o teste antigo era
    `regex_do_segredo AND verbo_de_leitura` procurados em QUALQUER lugar da
    linha, então uma delegação que mencionava um caminho e a palavra "tail" no
    meio da prosa era barrado como se estivesse lendo o arquivo.
    """
    for seg in _segmentos(cmd):
        try:
            tokens = shlex.split(seg, comments=False)
        except ValueError:
            # Aspas desbalanceadas: sem como tokenizar com confiança. Cai no
            # critério antigo (linha inteira), que erra para o lado de barrar.
            for rx, nome in SEGREDO:
                if re.search(rx, seg) and re.search(LEITURA.pattern[1:-1], seg):
                    return nome
            continue
        if not tokens:
            continue

        # O comando real é o primeiro token que não é prefixo, opção nem
        # atribuição de variável (VAR=valor antes do comando).
        verbo = ""
        for t in tokens:
            if t.startswith("-") or re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", t):
                continue
            base = os.path.basename(t)
            if PREFIXO.match(base):
                continue
            verbo = base
            break

        for t in tokens:
            tem_espaco = bool(re.search(r"\s", t))
            for rx, nome in SEGREDO:
                if not re.search(rx, t):
                    continue
                # (a) caminho como argumento próprio: é uso real, sempre barra.
                if not tem_espaco:
                    return nome
                # (b) string de código dada a python/node/bash: também é uso.
                if CODIGO.match(verbo):
                    return nome
                # (c) prosa: só barra se mandar LER o segredo ali mesmo, isto é,
                #     um verbo de leitura colado ao caminho (até ~30 chars).
                m = re.search(rx, t)
                antes = t[max(0, m.start() - 30):m.start()]
                if re.search(r"\b(?:cat|less|head|tail|grep|cp|mv|scp|base64|"
                             r"strings|source|abrir|leia|ler)\b", antes, re.I):
                    return nome
    return None


def avisa(texto):
    """Manda ao Telegram pelo unity-lib, que já filtra segredo e trunca.

    Em subprocesso para não importar o unity-lib aqui: se ele mudar de assinatura,
    o hook não quebra junto — e hook que quebra é agente travado.

    UNITY_HOOK_NO_NOTIFY existe para a bateria de testes rodar sem despejar uma
    mensagem por caso no chat do dono. Só suprime o aviso; o veredito "deny" é
    calculado igual, senão o teste não estaria testando o que importa.
    """
    if os.environ.get("UNITY_HOOK_NO_NOTIFY"):
        return
    try:
        subprocess.run(
            [sys.executable, "-c",
             "import sys;sys.path.insert(0,'/home/reaper/.local/bin');"
             "import importlib.util as u;"
             "s=u.spec_from_file_location('unity_lib','/home/reaper/.local/bin/unity-lib.py');"
             "m=u.module_from_spec(s);s.loader.exec_module(m);"
             "m.send_telegram(sys.stdin.read(), silent=False)"],
            input=texto, text=True, timeout=12,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def nega(motivo, aviso):
    avisa(aviso)
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": motivo,
        }
    }))


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return

    if payload.get("tool_name") not in ("Bash", "BashOutput"):
        return

    cmd = ((payload.get("tool_input") or {}).get("command") or "")
    if not cmd:
        return

    nome = usa_segredo(cmd)
    if nome:
        nega(
            f"Barrado: o comando alcança segredo ({nome}). O orquestrador "
            f"não precisa de chave nem de token para nenhuma tarefa. Não "
            f"há alternativa aqui — siga sem esse passo e relate. Citar o "
            f"caminho em texto é permitido; ler o arquivo, não.",
            f"🔒 BARRADO (segredo: {nome})\n\n{cmd[:600]}",
        )
        return

    if ISENTO.search(cmd):
        return

    for rx, nome in APAGA:
        if re.search(rx, cmd):
            nega(
                f"Barrado: o comando apaga dados ({nome}). Use `unity-trash "
                f"<caminho>` no lugar — move para ~/.trash-agent/ e nada se "
                f"perde. Não peça confirmação: refaça o passo com unity-trash.",
                f"🗑 BARRADO (exclusão: {nome})\n"
                f"Use unity-trash se for legítimo.\n\n{cmd[:600]}",
            )
            return


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
