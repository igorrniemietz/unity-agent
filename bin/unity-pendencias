#!/usr/bin/env python3
"""O que está EM ABERTO agora: sessões paradas, despachos sem retorno, memória
esperando aprovação.

Existe por uma pergunta do Igor que o resto do ferramental não respondia:
"quantos assuntos eu tenho em aberto, e quais sessões estão paradas há mais de
uma hora sem ninguém interagir — dá para encerrar sem deixar coisa pela
metade?". O `unity-uso` mostra CONSUMO, o `unity-despachar --lista` mostra só
despacho. Nenhum dos dois responde "o que ficou aberto".

Três fontes, porque três coisas ficam abertas de jeitos diferentes:

1. SESSÃO DE FUNDO VIVA E PARADA — segura contexto e pode ser encerrada.
   Fonte: `claude agents --json` cruzado com ~/.claude/jobs/<id>/state.json.
   O tempo parado vem do mtime do transcript, que é o último sinal REAL de
   interação; `updatedAt` do state.json mexe sozinho e mentiria para menos.

2. DESPACHO SEM RETORNO — o `unity-despachar` grava "rodando" e só grava
   "terminado" no fim. Se o processo filho morrer (máquina reiniciada, kill),
   o registro fica "rodando" para sempre. Esses são os que somem sem avisar.

3. MEMÓRIA AGUARDANDO APROVAÇÃO — o ai-memory está com
   `require_approval = true`, então proposta boa fica parada até alguém
   aprovar. Em 2026-08-01 havia duas paradas desde 31/07 sem ninguém saber.

A SESSÃO DONA DO CANAL DO TELEGRAM NUNCA É SUGERIDA PARA ENCERRAR. Ela fica
"parada" por definição — é isso que uma porteira faz entre mensagens. Encerrar
ela deixa o bot mudo até o timer recriar. Ela aparece marcada, nunca listada
como candidata.

Uso:
    unity-pendencias                # relatório
    unity-pendencias --linha        # uma linha, para rodapé do Telegram
    unity-pendencias --alerta       # imprime SÓ se houver algo; senão, silêncio
    unity-pendencias --horas 3      # muda o limite de "parada" (padrão 1h)
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

JOBS = Path.home() / ".claude/jobs"
TRANSCRIPTS = Path.home() / ".claude/projects/-home-reaper"
DESPACHOS = Path.home() / ".local/share/unity-orquestrador/despachos.jsonl"
SETTINGS = Path.home() / ".claude/settings.json"
AI_MEMORY = Path.home() / ".local/bin/ai-memory"
DATA_DIR = Path.home() / ".local/share/ai-memory"
HORAS_PADRAO = 1.0


def horas(desde):
    return (time.time() - desde) / 3600


def fmt_h(h):
    """'0.4h' fica ruim no celular; '25 min' e '3h10' se leem de relance."""
    if h < 1:
        return f"{int(h * 60)} min"
    minutos = int((h % 1) * 60)
    return f"{int(h)}h" if minutos == 0 else f"{int(h)}h{minutos:02d}"


def plural(n, singular, plural_):
    return f"{n} {singular}" if n == 1 else f"{n} {plural_}"


# ---------------------------------------------------------------- sessões

def agentes_vivos():
    """[(id, sessionId)] das sessões de fundo que o daemon reconhece."""
    try:
        p = subprocess.run(["claude", "agents", "--json"],
                           capture_output=True, text=True, timeout=25)
        dados = json.loads(p.stdout)
        lista = dados if isinstance(dados, list) else dados.get("agents", [])
        return [(x["id"], x.get("sessionId", "")) for x in lista if x.get("id")]
    except Exception:
        return []


def dona_do_canal(ident):
    """A sessão que segura o Telegram traz --channels nas flags de respawn."""
    try:
        d = json.loads((JOBS / ident / "state.json").read_text())
        return "--channels" in (d.get("respawnFlags") or [])
    except Exception:
        return False


def parada_ha(ident, session_id):
    """Horas desde a última interação real, pelo mtime do transcript."""
    if session_id:
        t = TRANSCRIPTS / f"{session_id}.jsonl"
        if t.exists():
            return horas(t.stat().st_mtime)
    try:
        return horas((JOBS / ident / "state.json").stat().st_mtime)
    except Exception:
        return 0.0


def assunto(ident):
    try:
        d = json.loads((JOBS / ident / "state.json").read_text())
        detalhe = (d.get("detail") or "").strip()
        # "(idle — send a prompt to start)" não é assunto, é ausência dele
        if detalhe.startswith("(") or detalhe == "stopped":
            return ""
        return detalhe
    except Exception:
        return ""


def sessoes(limite):
    canal, paradas = None, []
    for ident, sid in agentes_vivos():
        item = (ident, parada_ha(ident, sid), assunto(ident))
        if dona_do_canal(ident):
            canal = item
        elif item[1] >= limite:
            paradas.append(item)
    return canal, sorted(paradas, key=lambda x: -x[1])


# --------------------------------------------------------------- despachos

def despachos_abertos():
    """Despachos que começaram e nunca gravaram o fim."""
    if not DESPACHOS.exists():
        return []
    estado = {}
    for linha in DESPACHOS.read_text().splitlines():
        try:
            r = json.loads(linha)
        except Exception:
            continue
        estado[r["id"]] = r
    abertos = []
    for i, r in estado.items():
        if r.get("estado") != "rodando":
            continue
        abertos.append((i, horas(r["iniciado_em"]), r.get("nivel", "?"),
                        r.get("projeto", "?"), r.get("tarefa", "")[:60]))
    return sorted(abertos, key=lambda x: -x[1])


# ----------------------------------------------------------------- memória

def token():
    """O token mora no comando do hook em settings.json — fonte única."""
    if os.environ.get("AI_MEMORY_AUTH_TOKEN"):
        return os.environ["AI_MEMORY_AUTH_TOKEN"]
    try:
        s = json.loads(SETTINGS.read_text())
        cmd = s["hooks"]["SessionStart"][0]["hooks"][0]["command"]
        return re.search(r"--auth-token (\w+)", cmd).group(1)
    except Exception:
        return ""


def memorias_pendentes():
    try:
        env = dict(os.environ, AI_MEMORY_AUTH_TOKEN=token())
        p = subprocess.run(
            [str(AI_MEMORY), "--data-dir", str(DATA_DIR), "pending-writes", "list"],
            capture_output=True, text=True, timeout=40, env=env)
        return [l.split()[-1] for l in p.stdout.splitlines() if " pending " in l]
    except Exception:
        return []


# ------------------------------------------------------------------ saída

def main():
    ap = argparse.ArgumentParser(description="O que está em aberto agora.")
    ap.add_argument("--linha", action="store_true", help="uma linha só")
    ap.add_argument("--alerta", action="store_true",
                    help="imprime só se houver pendência (para o timer)")
    ap.add_argument("--horas", type=float, default=HORAS_PADRAO,
                    help=f"limite de sessão parada (padrão {HORAS_PADRAO})")
    a = ap.parse_args()

    canal, paradas = sessoes(a.horas)
    desp = despachos_abertos()
    mem = memorias_pendentes()
    total = len(paradas) + len(desp) + len(mem)

    if a.alerta and total == 0:
        return 0

    if a.linha:
        if total == 0:
            print("📌 nada em aberto")
            return 0
        p = []
        if paradas:
            p.append(plural(len(paradas), "sessão parada", "sessões paradas"))
        if desp:
            p.append(plural(len(desp), "despacho sem retorno",
                            "despachos sem retorno"))
        if mem:
            p.append(plural(len(mem), "memória pendente", "memórias pendentes"))
        print("📌 " + " · ".join(p))
        return 0

    if total == 0:
        print("✅ Nada em aberto.")
        if canal:
            print(f"\nCanal do Telegram de pé ({canal[0]}),")
            print(f"parado há {fmt_h(canal[1])} — normal.")
        return 0

    print("📌 EM ABERTO\n")

    if paradas:
        print("🟡 " + plural(len(paradas), "sessão parada", "sessões paradas")
              + f" há mais de {fmt_h(a.horas)}")
        for ident, h, tema in paradas:
            print(f"\n  {ident} — parada há {fmt_h(h)}")
            if tema:
                print(f"  assunto: {tema}")
            else:
                print("  assunto: (nunca recebeu tarefa)")
            print(f"  encerrar: claude stop {ident}")
        print()

    if desp:
        print("⏳ " + plural(len(desp), "despacho sem retorno",
                            "despachos sem retorno"))
        for i, h, nivel, projeto, tarefa in desp:
            print(f"\n  {i} — {nivel} → {projeto}")
            print(f"  aberto há {fmt_h(h)}")
            print(f"  tarefa: {tarefa}")
        print("\n  Se passou muito do tempo limite, o")
        print("  processo morreu sem gravar o fim.")
        print()

    if mem:
        print("📝 " + plural(len(mem), "memória esperando aprovação",
                            "memórias esperando aprovação"))
        for caminho in mem:
            print(f"  {caminho}")
        print("\n  aprovar: ai-memory pending-writes")
        print("           approve <id>")
        print()

    if canal:
        print(f"🔒 {canal[0]} é a dona do canal do")
        print(f"   Telegram. Parada há {fmt_h(canal[1])},")
        print("   e isso é o normal dela. NÃO encerre:")
        print("   o bot fica mudo até o timer recriar.")

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        print(f"unity-pendencias falhou: {exc}", file=sys.stderr)
        sys.exit(0)
