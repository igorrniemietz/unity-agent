#!/usr/bin/env python3
"""Visualizador de custo, separado por componente.

  unity-costs           hoje
  unity-costs --days 7  últimos 7 dias
"""
import json
import sys
import urllib.request
from collections import defaultdict
from datetime import date, timedelta
from pathlib import Path

LEDGER = Path.home() / ".local/share/llm-router"


def bar(frac, width=18):
    frac = max(0.0, min(1.0, frac))
    n = int(round(frac * width))
    return "█" * n + "░" * (width - n)


def carregar(dias):
    linhas = []
    for i in range(dias):
        p = LEDGER / f"{(date.today() - timedelta(days=i)).isoformat()}.jsonl"
        if not p.exists():
            continue
        for raw in p.read_text().splitlines():
            try:
                linhas.append(json.loads(raw))
            except Exception:
                pass
    return linhas


def main():
    dias = 1
    if "--days" in sys.argv:
        dias = int(sys.argv[sys.argv.index("--days") + 1])

    print(f"\n  Custo de LLM — {'hoje' if dias == 1 else f'últimos {dias} dias'}\n")

    # Cota do Claude: assinatura, medida em % e não em dólar.
    try:
        import subprocess
        out = subprocess.run(
            [str(Path.home() / ".local/bin/ai-usagebar"), "--vendor", "anthropic", "--json"],
            capture_output=True, text=True, timeout=15).stdout
        import re
        tip = re.sub("<[^>]+>", "", json.loads(out).get("tooltip", ""))
        sess = re.search(r"(\d+)%", tip)
        wk = re.findall(r"(\d+)%", tip)
        if sess and len(wk) >= 2:
            print(f"  Claude Pro (assinatura, não é dólar)")
            print(f"    sessão  {bar(int(wk[0])/100)}  {wk[0]:>3}%")
            print(f"    semana  {bar(int(wk[1])/100)}  {wk[1]:>3}%")
    except Exception:
        print("  Claude Pro: leitura indisponível")
    print()

    linhas = carregar(dias)
    por_cliente = defaultdict(lambda: defaultdict(float))
    tokens = defaultdict(lambda: [0, 0, 0])  # entrada, saída, raciocínio
    erros = 0
    for r in linhas:
        if r.get("error"):
            erros += 1
            continue
        por_cliente[r.get("client", "?")][r.get("provider", "?")] += r.get("cost_usd", 0.0)
        t = tokens[r.get("client", "?")]
        t[0] += r.get("prompt_tokens") or 0
        t[1] += r.get("completion_tokens") or 0
        t[2] += r.get("reasoning_tokens") or 0

    if not por_cliente:
        print("  Nenhuma chamada registrada.\n")
    else:
        print("  Por componente")
        total = 0.0
        for cli in sorted(por_cliente, key=lambda c: -sum(por_cliente[c].values())):
            sub = sum(por_cliente[cli].values())
            total += sub
            provs = ", ".join(f"{p}: US$ {v:.4f}" for p, v in sorted(por_cliente[cli].items()))
            ent, sai, rac = tokens[cli]
            desp = f" · {rac} de {sai} tokens de saída foram raciocínio" if rac else ""
            print(f"    {cli:<14} US$ {sub:.4f}   ({provs})")
            print(f"    {'':<14} {ent} entrada / {sai} saída{desp}")
        print(f"\n    {'TOTAL':<14} US$ {total:.4f}" + (f"   ({erros} chamada(s) com erro)" if erros else ""))
    print()

    # Orçamento do dia, direto do roteador (a fonte da verdade do teto).
    try:
        with urllib.request.urlopen("http://127.0.0.1:8787/budget", timeout=5) as resp:
            orc = json.load(resp)
        print("  Orçamento de hoje")
        for nome, v in orc["providers"].items():
            cap = v["cap_usd"]
            if not v["has_credential"]:
                print(f"    {nome:<10} — sem credencial (degrau pulado)")
            elif cap is None:
                print(f"    {nome:<10} gratuito, sem teto")
            else:
                print(f"    {nome:<10} {bar(v['spent_usd']/cap)}  US$ {v['spent_usd']:.4f} / {cap:.2f}")
    except Exception:
        print("  Orçamento: llm-router não respondeu")
    print()


if __name__ == "__main__":
    main()
