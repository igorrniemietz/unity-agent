#!/usr/bin/env python3
"""Hook PreToolUse: barra EnterWorktree que ia virar prompt sem quem responda.

O QUE ACONTECEU (07/10/2026, 04:25:27 BRT)

A Unity terminou o resgate da VPS, saiu do worktree (`Exiting worktree — Kept
worktree (branch worktree-vps-portable)`) e chamou

    EnterWorktree(/home/reaper/projetos/projeto-exemplo/.claude/worktrees/vps-portable)

O runtime NAO executou. Abriu um prompt:

    permission-root relocation to ".../projeto-exemplo/.claude/worktrees/vps-portable"
    — a model-supplied worktree outside .claude/worktrees/
    Do you want to proceed?  1. Yes  2. No

Ela ficou ali 35 min. As 3 mensagens que o dono mandou depois (incluindo
"alo travou esperando que aprovação") entraram na fila atras do bloqueio.

POR QUE O `allow` NAO SALVOU

`EnterWorktree` ESTA no allow do supervisor-settings.json desde sempre. O prompt
não é de ferramenta, é de **relocação da raiz de permissão**: o runtime só aceita
worktree do modelo dentro de `<raiz>/.claude/worktrees/`, e a raiz dela é $HOME.
Qualquer worktree de projeto cai fora e escala ACIMA da lista allow — mesma
família de [[project-unity-travada-prompt-permissao]], onde caminho absoluto num
redirect escalou acima de `Bash` liberado.

E não tem como consertar por configuração: EnterWorktree cria o worktree com git
no cwd, e o cwd dela ($HOME) não é repositório. Ou seja, para a Unity essa
ferramenta é 100% prompt e 0% trabalho feito.

A TRAVA E DE FERRAMENTA, NAO DE PROMPT

Mesma decisão do AskUserQuestion em 11/09: numa sessão de fundo, ferramenta que
pode abrir prompt não é risco, é paralisia garantida. Então é negada aqui, com a
alternativa no motivo — `git worktree add` + `cd` pelo Bash, que está no allow e
faz exatamente o mesmo trabalho sem mexer na raiz de permissão.

O discriminador não é o nome da ferramenta: é o INVARIANTE que o runtime exige.
Se algum dia o cwd da sessão for a raiz do repositório e o caminho cair dentro
de `<cwd>/.claude/worktrees/`, não há relocação, não há prompt, e o hook deixa
passar. Barrar só o que travaria.

Falha ABERTO como os outros hooks dela: se este script quebrar, volta o
comportamento do defaultMode em vez de o agente ficar sem a ferramenta.
"""
import json
import os
import sys



def avisa(texto):
    """Mesmo caminho dos outros hooks dela: unity-lib em subprocesso.

    Em subprocesso de proposito — se a assinatura do unity-lib mudar, o hook nao
    quebra junto, e hook que quebra e agente travado. UNITY_HOOK_NO_NOTIFY deixa
    a bateria de testes rodar sem despejar mensagem no chat do dono; so suprime o
    aviso, o veredito "deny" e calculado igual.
    """
    if os.environ.get("UNITY_HOOK_NO_NOTIFY"):
        return
    try:
        import subprocess
        subprocess.run(
            [sys.executable, "-c",
             "import sys;sys.path.insert(0,'/home/reaper/.local/bin');"
             "import importlib.util as u;"
             "s=u.spec_from_file_location('unity_lib','/home/reaper/.local/bin/unity-lib.py');"
             "m=u.module_from_spec(s);s.loader.exec_module(m);"
             "m.send_telegram(sys.stdin.read(), silent=False)"],
            input=texto, text=True, timeout=12,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def nega(motivo, aviso):
    avisa(aviso)
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": motivo,
        }
    }))


def relocaria(path, cwd):
    """True quando o caminho pedido fica fora de <cwd>/.claude/worktrees/.

    É exatamente a condição que o runtime chama de "model-supplied worktree
    outside .claude/worktrees/" e que abre o prompt de relocação. Sem caminho
    o runtime escolhe o dele, dentro da raiz: nada a barrar.
    """
    if not path:
        return False
    try:
        raiz = os.path.realpath(os.path.join(cwd or os.getcwd(),
                                             ".claude", "worktrees"))
        alvo = os.path.realpath(os.path.join(cwd or os.getcwd(), path))
    except Exception:
        return False
    return os.path.commonpath([raiz, alvo]) != raiz if alvo != raiz else False


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return

    if payload.get("tool_name") != "EnterWorktree":
        return

    entrada = payload.get("tool_input") or {}
    path = entrada.get("path") or ""
    cwd = payload.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or ""

    if not relocaria(path, cwd):
        return

    nega(
        "Barrado: esse worktree fica fora de <cwd>/.claude/worktrees/, então o "
        "runtime NAO executaria — ele abriria um prompt de relocação da raiz de "
        "permissão, e em sessão de fundo não existe quem aprove (foi o que me "
        "travou 35 min em 07/10/2026). Não peça aprovação e não tente de novo "
        "com outro caminho. Faça pelo Bash, que está liberado:\n"
        f"  git -C <repo> worktree add {path} -b <branch>\n"
        "  e trabalhe passando `git -C <path>` / `cd <path> && ...` em cada "
        "comando. O resultado é o mesmo worktree isolado, sem prompt.",
        "🚧 BARRADO (EnterWorktree fora da raiz)\n"
        f"{path[:300]}\n\n"
        "Ia abrir prompt de relocação e travar.\n"
        "Fiz por git worktree + cd no lugar.",
    )


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
