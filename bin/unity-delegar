    "sonnet": "Claude Sonnet",
    "gemini": "Gemini",
    "opencode": _rotulo_opencode(),
    "nex": _rotulo_nex(),
}

# As duas faixas que custam zero e rodam pelo binário do opencode. Andam
# sempre juntas: quem serializa a trava, quem revisa quem, e para onde as
# faixas pagas são rebaixadas — tudo se decide por esta tupla.
FAIXAS_GRATIS = ("opencode", "nex")

