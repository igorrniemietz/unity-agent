# Lista de permissão do executor. Fora do script porque é política, não código:
# mexer em quem pode o quê não deveria exigir editar o despachante.
DISPATCH_SETTINGS = Path.home() / ".claude/dispatch-settings.json"
LIMITE_AVISO = 2500  # caracteres do resultado que vão para o chat

# O opencode é instalado em ~/.opencode/bin e ligado por symlink no ~/.local/bin.
# O `which` cobre o uso normal; o caminho absoluto cobre o systemd, cujo PATH é
# mínimo e não inclui ~/.local/bin.
OPENCODE = shutil.which("opencode") or os.path.expanduser("~/.opencode/bin/opencode")
# O catálogo grátis do opencode zen ROTACIONA, e modelo que sai de lá não volta
# como erro honesto: o servidor responde `UnknownError / Unexpected server error`
# em ~5s, que não se distingue de queda do provedor.
#
# Medido em 24/08/2026: `deepseek-v4-flash-free` desapareceu do catálogo (só
# restaram 7 modelos zen, nenhum DeepSeek) e toda delegação --nivel opencode
# morria nesse erro. Sobreviventes testados com escrita de arquivo de verdade:
#   mimo-v2.5-free              18s  ✅
#   hy3-free                    38s  ✅
#   nemotron-3.5-lightning-free 52s  ✅
#   nemotron-3-ultra-free      105s  ✅ mas devolveu 502 da Nvidia logo depois
#   x-preview-f-free, big-pickle     ❌ não terminaram em 150s
# Padrão é o mais rápido que passou. Se ele sumir também, `opencode models`
# lista o que existe hoje — a lista acima é de 24/08, não é permanente.
#
# 23/09/2026: mimo-v2.5-free girou pra fora do catálogo (virou v2.6) e toda
# delegação opencode morria em ~5s com "Unexpected server error" sem aviso
# nenhum no Telegram (o dono só percebeu ao perguntar "cadê?" 37min depois).
# Atualizado pro nome atual — mas ele PODE girar de novo, então na próxima
# falha instantânea rode `opencode models` antes de assumir queda do provedor.
MODELO_OPENCODE = os.environ.get("UNITY_OPENCODE_MODEL",
                                 "opencode/mimo-v2.6-flash-free")

# Segunda faixa grátis, pedida pelo dono em 28/09/2026: o Nex N2.5 Pro pela
# OpenRouter, validado em 21/09 (construiu um site marketplace inteiro do zero).
# Roda pelo MESMO binário do opencode — muda só o `--model` e a credencial.
#
# Ter DUAS faixas grátis não é redundância: o catálogo zen rotaciona sem aviso
# (ver o histórico acima), e até hoje o dia em que o modelo saía era o dia em
# que a delegação barata inteira parava. Agora uma cobre a outra. E o revisor
# cruzado (`revisar_entrega`) precisa de dois modelos diferentes para existir:
# modelo revisando a si mesmo aprova o próprio erro.
MODELO_NEX = os.environ.get("UNITY_NEX_MODEL",
                            "openrouter/nex-agi/nex-n2.5-pro:free")

# Onde a chave da OpenRouter pode estar. O despachante LÊ, mas nunca imprime:
# a Unity não é o lugar onde chave de API mora, e o hook que bloqueia acesso a
# segredo está certo em barrá-la — por isso a busca acontece aqui dentro, em
# tempo de execução, e o valor nunca sai em log, em erro ou no Telegram.
CRED_OPENROUTER = Path.home() / ".config/unity/openrouter.key"
ENV_LLM_ROUTER = Path.home() / "infra/llm-router/.env"


def chave_openrouter():
    """A chave da OpenRouter, ou None. Nunca devolve pedaço dela em mensagem.

    Três lugares, nesta ordem: a variável de ambiente (quem chama já resolveu),
    um arquivo dedicado, e o `.env` do llm-router (onde as outras chaves desta
    casa já moram, então é o lugar que o dono espera).
    """
    k = (os.environ.get("OPENROUTER_API_KEY") or "").strip()
    if k:
        return k
    try:
        if CRED_OPENROUTER.is_file():
            k = CRED_OPENROUTER.read_text().strip()
            if k:
                return k
    except Exception:
        pass
    try:
        for linha in ENV_LLM_ROUTER.read_text().splitlines():
            linha = linha.strip()
            if linha.startswith("OPENROUTER_API_KEY="):
                k = linha.split("=", 1)[1].strip().strip("'\"")
                if k:
                    return k
    except Exception:
        pass
    return None


# Gemini 3.7 Flash Medium desde 15/08/2026 (era 3.6). Sai por variável porque
# trocar de modelo é rotina e não deveria exigir editar o despachante.
MODELO_GEMINI = os.environ.get("UNITY_GEMINI_MODEL", "gemini-3.7-flash-medium")

# Rótulo humano de cada faixa, para o aviso no Telegram.
#
# O da faixa `opencode` é DERIVADO do modelo, não escrito à mão. Ficou escrito
# "DeepSeek (opencode)" de 24/08 a 10/09/2026, mesmo depois de o DeepSeek sair
# do catálogo zen e o padrão virar `mimo-v2.5-free` — então todo relatório dizia
# DeepSeek enquanto rodava MiMo. Em 09/09 o dono cobrou "pedi para não usar o
# DeepSeek no pico e ele rodou": não rodou, mas o rótulo dizia que sim, e rótulo
# é a única coisa que ele vê. Nome de modelo é rotina de trocar; rótulo à mão
# envelhece calado e vira mentira.
def _rotulo_opencode(modelo=None):
    m = (modelo or MODELO_OPENCODE).split("/")[-1]
    if m.endswith("-free"):
        m = m[:-len("-free")] + " (grátis)"
    return f"{m} via opencode"


def _rotulo_nex(modelo=None):
    m = (modelo or MODELO_NEX).split("/")[-1].replace(":free", " (grátis)")
    return f"{m} via OpenRouter"


EXECUTORES = {
